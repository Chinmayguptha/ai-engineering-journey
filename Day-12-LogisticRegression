from sklearn.linear_model import LinearRegression

X = [[1], [2], [3], [4], [5]]

y = [30, 40, 50, 60, 70]

model = LinearRegression()

model.fit(X, y)

result = model.predict([[6]])

print("Predicted Marks:", result[0])





